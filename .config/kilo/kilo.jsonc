{
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "bash": {
      "echo *": "allow",
      "tr *": "allow",
      "grep *": "allow",
      "ls *": "allow",
      "command *": "allow",
      "source *": "allow",
      "qoder *": "allow",
      "head *": "allow",
      "rpm *": "allow",
      "flatpak *": "allow",
      "ps *": "allow",
      "sudo *": "allow",
      "tail *": "allow",
      "find *": "allow",
      "sed *": "allow",
      "python3 *": "allow",
      "bash *": "allow",
      "npx *": "allow",
      "git remote -v *": "allow",
      "which *": "allow",
      "update-alternatives *": "allow",
      "xdg-mime *": "allow",
      "readlink *": "allow",
      "printf *": "allow",
      "lp *": "allow",
      "rm *": "allow",
      "i3-msg *": "allow",
      "cp *": "allow",
      "chmod *": "allow",
      "zellij *": "allow",
      "v *": "allow",
      "git log *": "allow",
      "go test *": "allow",
      "go build *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git rev-parse *": "allow",
      "git diff *": "allow",
      "git branch *": "allow",
      "go run *": "allow",
      "curl *": "allow",
      "ss *": "allow",
      "pkill *": "allow",
      "sleep *": "allow",
      "timeout *": "allow",
      "awk *": "allow",
      "xargs *": "allow",
      "fuser *": "allow",
      "psql \"$DATABASE_URL\" *": "allow",
      "go vet *": "allow",
      "git rm *": "allow",
      "git reflog *": "allow",
      "git reset *": "allow",
      "go version *": "allow",
      "bun --version *": "allow",
      "node *": "allow",
      "mkdir *": "allow",
      "/usr/local/go/bin/go *": "allow",
      "go mod *": "allow",
      "bun create *": "allow",
      "bunx *": "allow",
      "git init *": "allow",
      "git status *": "allow",
      "git ls-files *": "allow",
      "wc *": "allow",
      "npm run build *": "allow",
      "bun run build *": "allow",
      "/home/ali/.bun/bin/bun *": "allow",
      "cat *": "allow",
      "git -C *": "allow",
      "bun run check *": "allow",
      "ufw status *": "allow",
      "pgrep *": "allow",
      "systemctl is-active *": "allow",
      "firewall-cmd *": "allow",
      "pactl *": "allow"
    },
    "external_directory": {
      "/home/ali/skills/*": "allow",
      "/home/ali/.local/bin/*": "allow",
      "/tmp/zellij/bootstrap/*": "allow",
      "/home/ali/*": "allow",
      "/etc/*": "allow"
    }
  }
}