# Backups and temporary files
*.bak
*.bak.*
config.backup.*
*~
*.swp
*.swo

# Spectacle writes backups of its own settings
spectaclerc.bak*

# History & cache
*history*
*.log
Cache/
cachedData/
node_modules/

# Credentials & secrets
*.pem
*.key
id_rsa*
id_ed25519*
*.env
*.env.*
auth.json
hosts.yml
save.txt

# OS artifacts
.DS_Store
Thumbs.db

# Browser data is deliberately never tracked. LibreWolf (~276M at
# ~/.config/librewolf) and Zen (~526M at ~/.var/app/app.zen_browser.zen) are
# full profiles: cookies, history, sessionstore and password databases.
# These entries are a safety net in case a future sync list reaches them.
librewolf/
.mozilla/
*.sqlite
*.sqlite*
*cookies*
*sessionstore*
*logins*.json
pkcs11.txt
cert9.db
key4.db
